{
  "expo": {
    "name": "Souk DZ",
    "slug": "c3f7328b752-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "soukdz",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#f97316"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.soukdz.app",
      "config": {
        "googleMapsApiKey": ""
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show nearby stores and delivery tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f97316"
      },
      "package": "com.soukdz.app",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Souk DZ to use your location for delivery tracking."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Souk DZ to access your photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Souk DZ to use your camera for visual search."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}